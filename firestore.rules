rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/apps/neighbor/communities/terra-lugo/users/$(request.auth.uid);
    }

    function profileExists() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function hasRole(roles) {
      return profileExists() && profile().role in roles && profile().status == 'active';
    }

    match /apps/neighbor/communities/terra-lugo/users/{userId} {
      allow create: if signedIn()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'resident'
          )
          || hasRole(['admin'])
        )
        && request.resource.data.uid == userId
        && request.resource.data.communityId == 'terra-lugo';

      allow read: if signedIn()
        && (request.auth.uid == userId || hasRole(['admin']));

      allow update: if signedIn()
        && (request.auth.uid == userId || hasRole(['admin']))
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.communityId == 'terra-lugo'
        && (hasRole(['admin']) || request.resource.data.role == resource.data.role);

      allow delete: if hasRole(['admin']);
    }

    match /apps/neighbor/communities/terra-lugo/activity/{activityId} {
      allow read: if profileExists();
      allow create: if profileExists()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.communityId == 'terra-lugo';
      allow update, delete: if hasRole(['admin']);
    }

    match /apps/neighbor/communities/terra-lugo/{collectionName}/{documentId} {
      allow read: if profileExists();
      allow create: if hasRole(['resident', 'guard', 'admin']);
      allow update: if hasRole(['guard', 'admin']);
      allow delete: if hasRole(['admin']);
    }

    match /apps/neighbor/communities/terra-lugo/{collectionName}/{documentId}/{subCollection}/{subDocumentId} {
      allow read: if profileExists();
      allow create: if hasRole(['resident', 'guard', 'admin']);
      allow update: if hasRole(['guard', 'admin']);
      allow delete: if hasRole(['admin']);
    }
  }
}
